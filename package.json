{
  "name": "parallel-browser-mcp",
  "version": "0.1.0",
  "description": "Playwright MCP with many isolated browser sessions running in parallel",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "parallel-browser-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node test/smoke.mjs",
    "test:unit": "npm run build && node --test --test-reporter=spec \"test/unit/*.test.mjs\"",
    "test:coverage": "npm run build && node --test --test-reporter=spec --experimental-test-coverage --enable-source-maps \"test/unit/*.test.mjs\"",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "playwright-core": "1.64.0-alpha-1790635538000",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
